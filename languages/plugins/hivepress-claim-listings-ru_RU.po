#: includes/components/class-listing-claim.php:122
msgid "You've already submitted a claim."
msgstr "Вы уже отправили запрос."

#: includes/configs/post-types.php:23
msgctxt "claim"
msgid "Add New"
msgstr "Добавить новый"

#: includes/configs/post-types.php:24 includes/configs/post-types.php:26
msgid "Add Claim"
msgstr "Добавить запрос"

#: includes/configs/strings.php:16
msgid "You can't claim your own listings."
msgstr "Вы не можете запрашивать доступ к собственным объявлениям."

#: includes/emails/class-listing-claim-approve.php:31
msgid "This email is sent to users when a claim is approved."
msgstr "Это письмо отправляется пользователям при одобрении запроса."

#: includes/emails/class-listing-claim-reject.php:31
msgid "This email is sent to users when a claim is rejected."
msgstr "Это письмо отправляется пользователям при отклонении запроса."

#. Description of the plugin
#: hivepress-claim-listings.php
msgid "Charge users for claiming listings."
msgstr "Берите плату с пользователей за доступ к объявлениям."

#. translators: %s: price.
#: includes/components/class-listing-claim.php:466
msgid "Claim for %s"
msgstr "Запросить доступ за %s"

#: includes/configs/post-types.php:21 includes/configs/post-types.php:27
#: includes/configs/settings.php:15
msgid "Claims"
msgstr "Запросы"

#: includes/configs/post-types.php:22
msgid "Claim"
msgstr "Запрос"

#: includes/configs/post-types.php:25
msgid "Edit Claim"
msgstr "Редактировать запрос"

#: includes/configs/post-types.php:28
msgid "Search Claims"
msgstr "Искать запросы"

#: includes/configs/post-types.php:29 includes/configs/post-types.php:30
msgid "No claims found."
msgstr "Запросов не найдено."

#: includes/configs/settings.php:35
msgid "Choose a product that must be purchased in order to submit a claim."
msgstr "Выберите продукт, который должен быть куплен для отправки запроса."

#: includes/configs/settings.php:44
msgid "Manually approve new claims"
msgstr "Вручную одобрять новые запросы"

#: includes/controllers/class-listing-claim.php:178
#: includes/emails/class-listing-claim-approve.php:30
#: includes/emails/class-listing-claim-approve.php:49
msgid "Claim Approved"
msgstr "Запрос одобрен"

#: includes/emails/class-listing-claim-approve.php:50
msgid "Hi, %user_name%! Your claim for listing \"%listing_title%\" has been approved, click on the following link to edit it: %listing_url%"
msgstr "Привет, %user_name%! Ваш запрос на доступ к объявлению \"%listing_title%\" был одобрен, кликните на эту ссылку чтобы редактировать его: %listing_url%"

#: includes/emails/class-listing-claim-reject.php:30
#: includes/emails/class-listing-claim-reject.php:49
msgid "Claim Rejected"
msgstr "Запрос отклонен"

#: includes/emails/class-listing-claim-reject.php:50
msgid "Hi, %user_name%! Unfortunately, your claim for listing \"%listing_title%\" has been rejected."
msgstr "Привет, %user_name%! К сожалению, ваш запрос доступа к объявлению \"%listing_title%\" был отклонен."

#: includes/configs/strings.php:14
msgid "Claim Listing"
msgstr "Запросить доступ"

#: includes/configs/strings.php:15
msgid "Please provide details that will help us verify that you're the owner of this listing."
msgstr "Пожалуйста, предоставьте детали которые помогут нам проверить, что вы являетесь владельцем этого объявления."

#. translators: %s: listing title.
#: includes/configs/strings.php:18
msgid "Thank you! Your claim for listing \"%s\" has been submitted and will be reviewed as soon as possible."
msgstr "Спасибо! Ваш запрос доступа к объявлению \"%s\" был отправлен и будет рассмотрен как можно скорее."

#. translators: %s: listing title.
#: includes/configs/strings.php:20
msgid "Thank you! Your claim for listing \"%s\" has been approved and you can start managing it."
msgstr "Спасибо! Ваш запрос доступа к объявлению \"%s\" был одобрен и вы можете начать управлять им."

#: includes/controllers/class-listing-claim.php:156
#: includes/emails/class-listing-claim-submit.php:30
msgid "Claim Submitted"
msgstr "Запрос отправлен"

#: includes/emails/class-listing-claim-submit.php:31
msgid "A new claim for listing \"%listing_title%\" %claim_url% has been submitted with the following details: %claim_details%"
msgstr "Новый запрос доступа к объявлению \"%listing_title%\" %claim_url% был отправлен со следующими деталями: %claim_details%"

#: includes/forms/class-listing-claim-submit.php:49
msgid "Your claim has been submitted."
msgstr "Ваш запрос отправлен."

#: includes/forms/class-listing-claim-submit.php:64
msgid "Submit Claim"
msgstr "Отправить запрос"

